{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "baseUrl": "./", 
    "paths": {
      "@oracle/*": ["backend/oracle/*"],
      "@contracts/*": ["artifacts/contracts/*"],
      "@utils/*": ["backend/utils/*"],
      "@config/*": ["backend/config/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}